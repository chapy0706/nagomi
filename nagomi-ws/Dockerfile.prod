ARG ERLANG_VERSION=27
ARG GLEAM_VERSION=v1.12.0

# Stage 1: 公式 Gleam イメージから gleam バイナリだけ取り出す
FROM ghcr.io/gleam-lang/gleam:${GLEAM_VERSION}-scratch AS gleam

# Stage 2: ビルドステージ（Gleam + Erlang）
FROM erlang:${ERLANG_VERSION}-alpine AS build
COPY --from=gleam /bin/gleam /bin/gleam

WORKDIR /app
COPY gleam.toml manifest.toml* ./
RUN gleam deps download

COPY src/ ./src/
COPY test/ ./test/
RUN gleam export erlang-shipment

# Stage 3: ランタイムステージ（Erlang のみ）
FROM erlang:${ERLANG_VERSION}-alpine

WORKDIR /app
COPY --from=build /app/build/erlang-shipment ./

EXPOSE 3001

ENTRYPOINT ["/app/entrypoint.sh"]
CMD ["run", "nagomi_ws"]
